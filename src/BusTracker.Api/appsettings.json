{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",
  "BusTracker": {
    "DatabasePath": "App_Data/bustracker.db",
    "Ibb": {
      "BaseUrl": "https://api.ibb.gov.tr/iett/",
      "TimeoutSeconds": 30
    },
    "Polling": {
      "FleetIntervalSeconds": 60,
      "CallsPerHour": 90,
      "RosterCallsPerHour": 60,
      "RosterCallsPerMinute": 10,
      "FleetReservedCalls": 45,
      "RosterMaxAgeMinutes": 60,
      "MemoryTrustHours": 72,
      "RosterRecheckMinutes": 3,
      "BackoffMinutes": [ 5, 10, 20, 30 ]
    },
    "AndroidApp": {
      "PackageName": "com.farukerata.kackaldi",
      "CertificateFingerprints": [ "2F:3B:75:15:A4:73:4D:3E:23:DB:CA:19:1B:9F:C5:33:EC:35:FA:36:D5:03:FB:6A:B9:DE:C6:5D:B7:D0:74:7A" ]
    },
    "RequestLog": {
      "Enabled": true,
      "RetentionDays": 14
    },
    "Tracking": {
      "StaleAfterSeconds": 180,
      "OffRouteMeters": 200,
      "StopOnRouteMeters": 40,
      "TerminalMeters": 150,
      "EtaModel": "speed"
    },
    "StaticData": {
      "RefreshHours": 24,
      "SyncEnabled": true,
      "SimplifyToleranceMeters": 5,
      "DownloadTimeoutMinutes": 15
    },
    "Access": {
      "InviteCodes": [],
      "LinkCodeMinutes": 10,
      "RegistrationsPerIpPer10Minutes": 10
    }
  }
}
