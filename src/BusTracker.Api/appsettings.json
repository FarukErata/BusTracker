{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",
  "BusTracker": {
    "DatabasePath": "App_Data/bustracker.db",
    "Ibb": {
      "BaseUrl": "https://api.ibb.gov.tr/iett/",
      "TimeoutSeconds": 30
    },
    "Polling": {
      "LineIntervalSeconds": 60,
      "FleetCallsPerMinute": 10,
      "HotLineTtlMinutes": 5,
      "BackoffMinutes": [ 2, 4, 8, 15 ]
    },
    "Tracking": {
      "StaleAfterSeconds": 180,
      "OffRouteMeters": 500,
      "TerminalWaitFraction": 0.2
    },
    "StaticData": {
      "RefreshHours": 24,
      "SyncEnabled": true,
      "SimplifyToleranceMeters": 5,
      "DownloadTimeoutMinutes": 15
    }
  }
}
