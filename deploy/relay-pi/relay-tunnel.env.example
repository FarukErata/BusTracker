# BusTracker Turkey relay — tunnel config.
# setup.sh copies this to /etc/relay-tunnel.env (only if it does not exist yet).
# Fill in VPS_HOST. This file holds no secrets (the private key is a separate file),
# so it is safe to keep; never commit a filled-in copy with your real host, though.

# The VPS that runs BusTracker, reachable from the Pi over the internet.
VPS_HOST=your.vps.example.com
# The restricted tunnel user created on the VPS (see docs/relayed-connection.md).
VPS_USER=tunnel
# VPS SSH port (22 unless you changed it).
VPS_PORT=22

# Where the remote SOCKS5 proxy listens ON THE VPS.
# 172.17.0.1 is the Docker bridge gateway, reachable from the BusTracker container
# via host.docker.internal. Binding to a non-loopback address needs
# "GatewayPorts clientspecified" in the VPS sshd_config.
BIND=172.17.0.1
PORT=1080

# Private key on the Pi whose PUBLIC key is in the VPS tunnel user's authorized_keys.
# setup.sh generates this if it is missing.
SSH_KEY=/home/relay/.ssh/relay_tunnel
